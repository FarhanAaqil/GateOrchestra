# GateOrchestra Environment Variables Example
# Copy to .env. Values here override shared/config.py.

# Provider: ollama (local, default) | groq (cloud) | mock (offline simulation, ungraded)
GATE_LLM_PROVIDER=ollama

# Ollama. The Blueprint model is qwen2.5:7b-instruct; qwen2.5:3b fits a 4 GB GPU
# and is what the recorded benchmark used. Serve the same model the gate was
# trained on, because the gate's features come from that model's probe.
GATE_API_BASE=http://localhost:11434
GATE_MODEL_NAME=qwen2.5:3b

# Groq (rate-limited on the free tier; calls back off and retry on 429)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# How the MAS picks a sub-agent: bandit (learned during the benchmark; falls
# back to auto until trained) | auto (text heuristic) | react | debate | reflexion
GATE_MAS_ROUTER=bandit

# ---------------------------------------------------------------------------
# Chat assistant (Chat page, POST /chat)
# ---------------------------------------------------------------------------
# Providers tried in order. Extra keys rotate when one is rate-limited:
# GROQ_API_KEYS=key2,key3   GEMINI_API_KEY=your_gemini_key   GEMINI_API_KEYS=...
ASSISTANT_PROVIDERS=groq,gemini
# Use the local Ollama model when every cloud provider fails.
ASSISTANT_LOCAL_FALLBACK=false
# Groq model per role (each Groq model has its own rate limit).
ASSISTANT_PROBE_MODEL=openai/gpt-oss-20b
ASSISTANT_FAST_MODEL=openai/gpt-oss-20b
ASSISTANT_ANSWER_MODEL=openai/gpt-oss-120b
ASSISTANT_AGENT_MODEL=qwen/qwen3.8-27b
# Gate routing: auto (cheapest gate within the margin of the best rated
# accuracy) | learned | rule_based | always_stop | always_escalate
ASSISTANT_GATE_MODE=auto
ASSISTANT_GATE_MARGIN=0.02
# Prompt-injection screening with Groq's prompt-guard model.
ASSISTANT_GUARD=true
ASSISTANT_GUARD_THRESHOLD=0.9
# Seconds a repeated first question is answered from the cache (0 = off).
ASSISTANT_CACHE_TTL=86400

# ---------------------------------------------------------------------------
# Running in production
# ---------------------------------------------------------------------------
# Require "Authorization: Bearer <token>" on every endpoint except /health.
GATE_API_TOKEN=
# Allowed browser origins, comma-separated (use your site, not *).
GATE_CORS_ORIGINS=*
# Chat and upload requests per client per minute.
GATE_RATE_LIMIT_PER_MINUTE=30
# Lets a proxied deployment add API keys from the console.
GATE_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Hosted, multi-user mode (off by default; see deploy/HOSTED.md)
# ---------------------------------------------------------------------------
# With GATE_HOSTED=true the API refuses to start unless GATE_CORS_ORIGINS lists
# real origins (never *), GATE_ADMIN_TOKEN is set (24+ characters), only cloud
# providers are configured (no Ollama) and a Groq or Gemini key is present.
# Research and operator endpoints (/run, /history, /assistant/stats, /status,
# /cache, /keys, /metrics) become admin-only.
GATE_HOSTED=false
# Proxies whose X-Forwarded-For header is believed (IPs or CIDR ranges).
# In hosted mode an empty list means the header is ignored.
GATE_TRUSTED_PROXIES=
# Accounts (hosted mode). Admins are these addresses, once they confirm them.
GATE_ADMIN_EMAILS=
# The site's public address, used in emailed links (https:// in production).
GATE_PUBLIC_URL=https://gate.example.com
# Session cookies are Secure (HTTPS only) unless this is false (local testing).
GATE_COOKIE_SECURE=true
# Account emails: smtp, or console (kept in memory, for local testing only).
GATE_MAIL_BACKEND=smtp
GATE_SMTP_HOST=
GATE_SMTP_PORT=587
GATE_SMTP_USER=
GATE_SMTP_PASSWORD=
GATE_MAIL_FROM=
# Encrypts people's own API keys at rest (required when hosted). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATE_ENCRYPTION_KEY=
# Plans and their limits live in configs/plans.yaml. The operator's safety switch:
# tokens per UTC day across everyone on the operator's keys (overrides the file).
GATE_GLOBAL_DAILY_TOKENS=
# Chat and upload requests per person per minute, and sandbox runs at once.
GATE_USER_RATE_LIMIT_PER_MINUTE=10
GATE_SANDBOX_PER_USER=1
GATE_SANDBOX_MAX_CONCURRENT=4
# Upgrade button: your payment provider's hosted payment page (https). {email} is
# replaced with the person's email, so you can match the payment to the account,
# e.g. a Stripe Payment Link with ?prefilled_email={email}. An admin then sets the
# plan on the Admin page; it lapses back to Free when the paid period ends.
GATE_PAYMENT_LINK=
# The site's domain for deploy/docker-compose.hosted.yml (Caddy gets its certificate).
GATE_DOMAIN=
# Days of nightly database backups to keep in ./backups.
GATE_BACKUP_KEEP_DAYS=14
# Optional error tracking (pip install sentry-sdk). Request data never leaves the server.
SENTRY_DSN=
# One JSON log line per request (always on when hosted): ids and timings, never content.
GATE_REQUEST_LOG=0
# Admins must switch on two-factor sign-in before admin pages open (recommended).
GATE_REQUIRE_ADMIN_2FA=false
# Failed passwords or codes per account in 15 minutes before sign-in is paused.
GATE_LOGIN_FAILURES=5
# API worker processes in deploy/docker-compose.hosted.yml (limits are shared via the database).
GATE_WORKERS=2
# Any OpenAI-compatible provider (OpenAI, OpenRouter, Together, a paid Groq account...).
# Add "openai" to ASSISTANT_PROVIDERS to use it. ASSISTANT_OPENAI_<ROLE>_MODEL overrides
# the model per role (PROBE, FAST, ANSWER, AGENT).
OPENAI_API_KEY=
ASSISTANT_OPENAI_BASE=https://api.openai.com/v1
ASSISTANT_OPENAI_MODEL=gpt-4o-mini
