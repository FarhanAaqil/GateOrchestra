# GateOrchestra Environment Variables Example
# Copy to .env. Values here override shared/config.py.

# Provider: ollama (local, default) | groq (cloud) | mock (offline simulation, ungraded)
GATE_LLM_PROVIDER=ollama

# Ollama. The Blueprint model is qwen2.5:7b-instruct; qwen2.5:3b fits a 4 GB GPU
# and is what the recorded benchmark used. Serve the same model the gate was
# trained on, because the gate's features come from that model's probe.
GATE_API_BASE=http://localhost:11434
GATE_MODEL_NAME=qwen2.5:3b

# Groq (rate-limited on the free tier; calls back off and retry on 429)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# How the MAS picks a sub-agent: bandit (learned during the benchmark; falls
# back to auto until trained) | auto (text heuristic) | react | debate | reflexion
GATE_MAS_ROUTER=bandit

# ---------------------------------------------------------------------------
# Chat assistant (Chat page, POST /chat)
# ---------------------------------------------------------------------------
# Providers tried in order. Extra keys rotate when one is rate-limited:
# GROQ_API_KEYS=key2,key3   GEMINI_API_KEY=your_gemini_key   GEMINI_API_KEYS=...
ASSISTANT_PROVIDERS=groq,gemini
# Use the local Ollama model when every cloud provider fails.
ASSISTANT_LOCAL_FALLBACK=false
# Groq model per role (each Groq model has its own rate limit).
ASSISTANT_PROBE_MODEL=openai/gpt-oss-20b
ASSISTANT_FAST_MODEL=openai/gpt-oss-20b
ASSISTANT_ANSWER_MODEL=openai/gpt-oss-120b
ASSISTANT_AGENT_MODEL=qwen/qwen3.8-27b
# Gate routing: auto (cheapest gate within the margin of the best rated
# accuracy) | learned | rule_based | always_stop | always_escalate
ASSISTANT_GATE_MODE=auto
ASSISTANT_GATE_MARGIN=0.02
# Prompt-injection screening with Groq's prompt-guard model.
ASSISTANT_GUARD=true
ASSISTANT_GUARD_THRESHOLD=0.9
# Seconds a repeated first question is answered from the cache (0 = off).
ASSISTANT_CACHE_TTL=86400

# ---------------------------------------------------------------------------
# Running in production
# ---------------------------------------------------------------------------
# Require "Authorization: Bearer <token>" on every endpoint except /health.
GATE_API_TOKEN=
# Allowed browser origins, comma-separated (use your site, not *).
GATE_CORS_ORIGINS=*
# Chat and upload requests per client per minute.
GATE_RATE_LIMIT_PER_MINUTE=30
# Lets a proxied deployment add API keys from the console.
GATE_ADMIN_TOKEN=
